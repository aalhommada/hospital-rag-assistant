# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database — matches docker-compose.yml. Port 5433 avoids clashing with a
# Postgres you may already run locally on 5432.
# ---------------------------------------------------------------------------
POSTGRES_DB=hospital_rag
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Claude — the only API key this project needs.
# Get one at https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model used to write grounded answers. Sonnet is the sensible default: this job
# is careful copying and citing, not hard reasoning. Move to claude-opus-5 if you
# see it paraphrasing numbers or missing citations.
CLAUDE_ANSWER_MODEL=claude-sonnet-5

# Model used to classify each incoming question and rewrite it for search. This
# call runs on EVERY message, so it is where model cost is decided.
#
# It is also the safety-critical decision — it is what separates "how long must I
# fast?" from "should I stop my warfarin?". Do not downgrade it on a hunch. Run
# `make evaluate-routing`, which scores all 47 labelled questions and reports
# separately on anything that should have been refused and was not.
#
# claude-haiku-4-5 is the cheapest option worth trying here.
CLAUDE_ROUTER_MODEL=claude-sonnet-5

# Server-side refusal fallbacks. A hospital corpus sits close to topics that
# safety classifiers watch; with this on, a declined request is retried by the
# API on a fallback model inside the same call instead of returning nothing.
CLAUDE_ENABLE_FALLBACKS=true

# ---------------------------------------------------------------------------
# Embeddings
#   local   — runs on your machine via ONNX, no API key, 384 dimensions (default)
#   voyage  — VOYAGE_API_KEY required
#   openai  — OPENAI_API_KEY required
# Switching provider changes the vector width; see README "Changing the
# embedding model" before you do it.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
# How many candidates each search arm returns before fusion.
RETRIEVAL_CANDIDATES=30
# How many chunks end up in the prompt.
RETRIEVAL_TOP_K=6
# Cosine similarity a chunk must reach to enter the prompt. This is what lets
# the assistant say "the documents do not cover this" instead of inventing an
# answer. Run `make evaluate` after changing it.
RETRIEVAL_MIN_SIMILARITY=0.65
